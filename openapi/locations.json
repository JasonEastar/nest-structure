  "info": {
    "title": "C9 Map · Locations",
    "description": "Địa điểm user tự lưu (tên, toạ độ, bán kính) và truy vấn địa điểm công khai quanh một toạ độ (PostGIS).\n\nMọi response có cùng 5 field: `success`, `code`, `msg`, `data`, `meta`. Khi lỗi: `success=false`, `data=null`, `code` là mã lỗi, `msg` là câu đã dịch.\n\nNgôn ngữ: header `Accept-Language: vi | en` (mặc định vi).",
    "version": "1",
    "contact": {}
  },
  "tags": [
    {
      "name": "Locations",
      "description": "Địa điểm đã lưu, công khai hoặc riêng tư"
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "Máy chủ đang mở trang này"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "supabase": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Mã lỗi SCREAMING_SNAKE, client rẽ nhánh theo mã này"
              },
              "message": {
                "type": "string",
                "description": "Đã dịch theo header Accept-Language (vi mặc định, en)"
              },
              "params": {
                "type": "object",
                "additionalProperties": {},
                "description": "Dữ liệu phụ: resource, retryAfter, issues…"
              },
              "requestId": {
                "type": "string",
                "description": "Gửi kèm khi báo lỗi để tra log"
              }
            },
            "required": [
              "code",
              "message",
              "params",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "CreateLocation": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "radiusMeters": {
            "default": 500,
            "type": "integer",
            "minimum": 100,
            "maximum": 5000
          },
          "isPublic": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "lat",
          "lng"
        ]
      },
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "radiusMeters": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "isPublic": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "lat",
          "lng",
          "radiusMeters",
          "isPublic",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "PublicLocation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "distanceMeters": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "lat",
          "lng",
          "distanceMeters"
        ],
        "additionalProperties": false
      }
    }
  }
}