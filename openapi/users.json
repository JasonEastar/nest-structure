  "info": {
    "title": "C9 Map · User & Auth",
    "description": "Đăng nhập Google qua Supabase, hồ sơ /me, role và permission. Backend không phát token, chỉ xác minh JWT.\n\nMọi response có cùng 5 field: `success`, `code`, `msg`, `data`, `meta`. Khi lỗi: `success=false`, `data=null`, `code` là mã lỗi, `msg` là câu đã dịch.\n\nNgôn ngữ: header `Accept-Language: vi | en` (mặc định vi).",
    "version": "1",
    "contact": {}
  },
  "tags": [
    {
      "name": "Me",
      "description": "Hồ sơ của user đang đăng nhập"
    },
    {
      "name": "Roles",
      "description": "Quản trị role/permission (cần quyền)"
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "Máy chủ đang mở trang này"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "supabase": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "code": {
            "type": "string",
            "description": "Mã lỗi SCREAMING_SNAKE, client rẽ nhánh theo mã này"
          },
          "msg": {
            "type": "string",
            "description": "Câu đã dịch theo header Accept-Language (vi mặc định, en)"
          },
          "data": {
            "type": "string",
            "nullable": true,
            "enum": [
              null
            ]
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string",
                "description": "Gửi kèm khi báo lỗi để tra log"
              }
            },
            "required": [
              "requestId"
            ],
            "additionalProperties": {},
            "description": "Luôn có requestId; endpoint list thêm nextCursor; khi lỗi thêm chi tiết (issues, reason…)"
          }
        },
        "required": [
          "success",
          "code",
          "msg",
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "nullable": true,
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "displayName": {
            "type": "string"
          },
          "username": {
            "nullable": true,
            "type": "string"
          },
          "avatarUrl": {
            "nullable": true,
            "type": "string",
            "format": "uri"
          },
          "locale": {
            "type": "string"
          },
          "homeCityCode": {
            "nullable": true,
            "type": "string"
          },
          "phoneVerified": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "moderator",
                "venue",
                "admin"
              ]
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "username",
          "avatarUrl",
          "locale",
          "homeCityCode",
          "phoneVerified",
          "roles",
          "permissions"
        ],
        "additionalProperties": false
      },
      "Role": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "user",
              "moderator",
              "venue",
              "admin"
            ]
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "name",
          "permissions"
        ],
        "additionalProperties": false
      },
      "UserRoles": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "moderator",
                "venue",
                "admin"
              ]
            }
          }
        },
        "required": [
          "id",
          "roles"
        ],
        "additionalProperties": false
      },
      "SetUserRoles": {
        "type": "object",
        "properties": {
          "roles": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "moderator",
                "venue",
                "admin"
              ]
            }
          }
        },
        "required": [
          "roles"
        ]
      }
    }
  }
}