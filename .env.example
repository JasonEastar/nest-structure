# c9_map — copy thành .env (không commit .env)
# Trong docker-compose, DATABASE_URL/REDIS_URL/INSTANCE_ID được ghi đè theo service.

# --- App ---
NODE_ENV=development          # development | test | production
PORT=3000                     # trong container luôn 3000; nginx publish ra ngoài
INSTANCE_ID=api-local         # mặc định hostname; compose đặt api-1 / api-2
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace
# URL công khai của API khi deploy (hiện trong Swagger → Servers). Local bỏ trống.
# PUBLIC_URL=https://api.c9map.vn
TRUST_PROXY_HOPS=1            # số reverse proxy phía trước: nginx = 1, ALB + nginx = 2

# --- Postgres 16 + PostGIS (container trong compose ở MỌI môi trường, tự host) --- phase 03
# Port host của compose (đổi khi máy đã có Postgres/Redis khác chiếm 5432/6379)
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
NGINX_HOST_PORT=3000
DATABASE_URL=postgres://c9:c9@127.0.0.1:5432/c9_map

# --- Redis 7 (app tự dùng db0 cache, db1 BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379
# REDIS_INSIGHT_HOST_PORT=5540    # UI Redis: npm run dev:tools
THROTTLE_SHORT_LIMIT=10       # request / giây / tracker (user → device → ip)
THROTTLE_LONG_LIMIT=100       # request / phút

# --- Supabase: CHỈ auth (Google sign-in). Dashboard → Project Settings → API Keys --- phase 06
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json   # tuỳ chọn, mặc định suy từ SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # dùng cho scripts/dev-token.mjs và E2E auth
SUPABASE_SECRET_KEY=sb_secret_...             # chỉ server, không bao giờ đưa vào client/image/log

# --- Sentry (tuỳ chọn): lỗi 5xx kèm stack, log (Sentry Logs), trace 10 % request. Bỏ trống = tắt ---
# SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>
