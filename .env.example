NODE_ENV=development             # production trên server
LOG_LEVEL=info                   # debug khi cần soi

# Postgres + PostGIS, Redis chạy bằng `npm run dev:infra` (docker compose)
DATABASE_URL=postgres://c9:c9@127.0.0.1:5432/c9_map
REDIS_URL=redis://127.0.0.1:6379

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Chỉ khi deploy
PUBLIC_URL=                      # https://api.c9map.vn → Swagger Servers
SENTRY_DSN=                      # DSN project prod; trống = tắt
