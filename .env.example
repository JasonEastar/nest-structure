# c9_map — copy thành .env (không commit .env)
# Trong docker-compose, DATABASE_URL/REDIS_URL/INSTANCE_ID được ghi đè theo service.

# --- App ---
NODE_ENV=development          # development | test | production
PORT=3000                     # trong container luôn 3000; nginx publish ra ngoài
INSTANCE_ID=api-local         # mặc định hostname; compose đặt api-1 / api-2
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace
TRUST_PROXY_HOPS=1            # số reverse proxy phía trước: nginx = 1, ALB + nginx = 2

# --- Postgres 16 + PostGIS (container trong compose ở MỌI môi trường, tự host) --- phase 03
# Port host của compose (đổi khi máy đã có Postgres/Redis khác chiếm 5432/6379)
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
NGINX_HOST_PORT=3000
DATABASE_URL=postgres://c9:c9@127.0.0.1:5432/c9_map

# --- Redis 7 (db0 cache, db1 BullMQ; prod: 2 instance vì eviction không đặt theo db) --- phase 05
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
THROTTLE_SHORT_LIMIT=10       # request / giây / tracker (user → device → ip)
THROTTLE_LONG_LIMIT=100       # request / phút

# --- Supabase: CHỈ auth (Google sign-in). Lấy từ Dashboard → Project Settings → API --- phase 06
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # chỉ server, không bao giờ đưa vào client/image
